<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Script" referent="RBXC746A19A16C846169DBBBB427D98A4D4">
		<Properties>
			<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")

local pluginConfig = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Float, false, false, 300, 400, 300, 400
)

local window = plugin:CreateDockWidgetPluginGuiAsync("keyframeConvert", pluginConfig)
window.Title = "Keyframe Converter for Vortex"

local container = script.Main:Clone()
container.Parent = window

local selected
local converted = ""

local toolbar = plugin:CreateToolbar("keyframeConverterWindow")
local button = toolbar:CreateButton("keyframeConverterButton", "Keyframe Converter for Vortex", "", "KeyframeConverter")

button.Click:Connect(function()
	window.Enabled = not window.Enabled
end)

local easingStyles = {
	[Enum.PoseEasingStyle.Linear] = Enum.EasingStyle.Linear,
	[Enum.PoseEasingStyle.Cubic] = Enum.EasingStyle.Cubic,
	[Enum.PoseEasingStyle.CubicV2] = Enum.EasingStyle.Cubic,
	[Enum.PoseEasingStyle.Bounce] = Enum.EasingStyle.Bounce,
	[Enum.PoseEasingStyle.Elastic] = Enum.EasingStyle.Elastic,
	[Enum.PoseEasingStyle.Constant] = "Constant",
}

local function GetPoseTable(instance : Instance)
	local poseTable = {}
	for _, pose : Pose in instance:GetChildren() do
		local poseKey = {
			Keyframes = GetPoseTable(pose),
			CFrame = pose.CFrame,
			EasingStyle = easingStyles[pose.EasingStyle],
			EasingDirection = Enum.EasingDirection:FromName(pose.EasingDirection.Name),
		}
		
		poseTable[pose.Name] = poseKey
	end
	
	return poseTable
end

local function GetStringFromTable(tabWidth, tarTable : {})
	local tableStrings = {}
	local index = 1
	for name, element in tarTable do
		if typeof(element) == "table" then
			tableStrings[index] = string.rep("	", tabWidth)..`["{name}"] = \{`
			tabWidth += 1
			
			for _, str in ipairs(GetStringFromTable(tabWidth, element)) do
				index += 1
				tableStrings[index] = str
			end
			
			tabWidth -= 1
			index += 1
			tableStrings[index] = string.rep("	", tabWidth)..`\},`
		elseif typeof(element) == "CFrame" then
			tableStrings[index] = string.rep("	", tabWidth)..`["{name}"] = CFrame.new({element}),`
		elseif typeof(element) == "string" then
			tableStrings[index] = string.rep("	", tabWidth)..`["{name}"] = "{element}",`
		else
			tableStrings[index] = string.rep("	", tabWidth)..`["{name}"] = {element},`
		end
		index += 1
	end
	return tableStrings
end

container.Convert.Activated:Connect(function()
	local keyframes = selected:GetChildren() :: {Keyframe}
	table.sort(keyframes, function(a, b)
		return a.Time < b.Time
	end)
	
	local keyCollection = {}
	for _, keyframe in keyframes do
		local time = keyframe.Time
		local keyTable = {
			Time = time,
			Keyframes = GetPoseTable(keyframe)
		}
		table.insert(keyCollection, keyTable)
	end
	
	-- convert
	local tabWidth = 1
	local tableStrings = {
		"{",
		`	Name = "{selected.Name}"`,
		`	Looped = {selected.Loop}`,
	}
	local index = 4
	for i, element in keyCollection do
		tableStrings[index] = string.rep("	", tabWidth)..`[{i}] = \{`
		tabWidth += 1
		
		for _, str in ipairs(GetStringFromTable(tabWidth, element)) do
			index += 1
			tableStrings[index] = str
		end
		
		tabWidth -= 1
		index += 1
		tableStrings[index] = string.rep("	", tabWidth)..`\},`
		
		index += 1
	end
	table.insert(tableStrings, "}")
	
	converted = table.concat(tableStrings, "\n")
end)

RunService.Heartbeat:Connect(function()
	selected = Selection:Get()[1]
	if selected then
		if not selected:IsA("KeyframeSequence") then
			container.Convert.Interactable = false
			container.Convert.Text = "Not valid KeyframeSequence"
		else
			container.Convert.Interactable = true
			container.Convert.Text = "Convert"
		end
		container.Selected.Text = "Selected: "..selected.Name
	else
		container.Selected.Text = "Nothing selected"
		container.Convert.Interactable = false
		container.Convert.Text = "No instance selected"
	end
	container.Scroll.Converted.Text = converted
end)]]></ProtectedString>
